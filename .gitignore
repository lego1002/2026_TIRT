# SolidWorks lock files
~$*

# SolidWorks backup files
*.swp
*.bak

# colcon build artifacts (local-only; rebuilt in the ROS 2 workspace)
/install
/log
/build

# Python bytecode caches
__pycache__/
*.pyc

# 真正的 netplan 檔含 WiFi 密碼,不進版控;只追蹤 net/60-tirt-wifi.yaml.example
/net/60-tirt-wifi.yaml
/net/*.yaml.bak.*

